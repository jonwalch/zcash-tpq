# Private environment for the TPQ walkthrough (zdn.md). Copy to "$WORK/env.sh",
# mode 0600, and load it with `. "$WORK/env.sh"` in every terminal.
# It holds paths and public identifiers only. Never put passwords, keys,
# cookies or AWS credentials here.
umask 077

# --- Step 1: set these two, then review the pins below. -----------------------
DOWNLOADS=/REPLACE/absolute/verified-downloads   # where START-TPQ.md extracted
WORK=/REPLACE/absolute/new-private-tpq-work      # the directory holding this file

ENV="$WORK/env.sh"
WORK=$(cd "$WORK" 2>/dev/null && pwd -P || printf '%s' "$WORK")

# Layout written by START-TPQ.md. Change only if your candidate uses other names.
ZDN="$DOWNLOADS/zdn"
HOST_HELPER="$ZDN"
HOST_ADAPTER="$DOWNLOADS/zdn-tpq-adapter"
IMPORT="$DOWNLOADS/zdn-tpq-import"
DEVNET="$DOWNLOADS/tpq-devnet"
WALLET="$DOWNLOADS/pq-wallet"
NODE_SOURCE="$DOWNLOADS/node-source"
STARTER="$DOWNLOADS/tpq/docs/slh-dsa-b128s/zdn-preview"

# From distribution.json: source.nodeRevision and source.tpqRevision.
NODE_REV=REPLACE_DISTRIBUTED_NODE_SOURCE_REVISION
TPQ_REV=REPLACE_ORIGINAL_TPQ_REVISION
# The build-manifest.json SHA-256 printed in START-TPQ.md "Selection and evidence".
ADAPTER_SELECTION_SHA256=REPLACE_BUILD_MANIFEST_SHA256

STATE="$WORK/state"
CONFIG_DIR="$WORK/config"
CONFIG="$CONFIG_DIR/external.yaml"

# --- Step 2: cohort (1-30 letters, digits or _; no hyphens). ------------------
COHORT=tpq_trial_1
PUBLIC="$WORK/cohort-public"
PRIVATE="$WORK/cohort-private"
CHAIN="$PUBLIC/chain.json"
PROFILE="$PUBLIC/wallet-profile.json"
FUNDER="$PRIVATE/funder.json"
PACKAGE="$WORK/public-package"
TRUST="$WORK/core-trust.json"

# --- Step 4: AWS scope. --------------------------------------------------------
AWS_PROFILE=REPLACE_AUTHENTICATED_AWS_PROFILE
ACCOUNT_ID=REPLACE_OWN_TWELVE_DIGIT_ACCOUNT_ID
# An IAM user ARN, or for SSO/assumed roles the IAM *role* ARN with its path
# (arn:aws:iam::ACCOUNT:role/PATH/NAME), not the sts ...:assumed-role/... ARN.
TRUST_PRINCIPAL=REPLACE_EXACT_IAM_USER_OR_ROLE_ARN
REGION=REPLACE_AWS_REGION
TEAM=REPLACE_NEW_DISPOSABLE_TEAM
BUCKET=REPLACE_NEW_GLOBALLY_UNIQUE_BUCKET
ZDN_PROFILE=default    # also written into external.yaml's `profile` field

# --- Values captured by later steps are appended below this line. -------------
